{
  "name": "dyslexia-friendly",
  "displayName": "Dyslexia Friendly VS Code",
  "description": "Made your code editor Dyslexia Friendly",
  "version": "1.0.3",
  "icon": "images/image.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/markschellhas/dyslexia-friendly-vscode"
  },
  "author": {
    "name": "Mark Schellhas",
    "email": "mark@schellhas.se"
  },
  "publisher": "markschellhas",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.changeToDyslexiaFriendly",
        "title": "Make Dyslexia Friendly"
      }
    ],
    "configuration": {
      "title": "Dyslexia Friendly",
      "properties": {
        "dyslexiaFriendly.boldFontWeight": {
          "type": "string",
          "enum": [
            "bold",
            "bolder",
            "500",
            "600",
            "700",
            "800",
            "900"
          ],
          "default": "bold",
          "description": "Font weight to use instead of italics"
        },
        "dyslexiaFriendly.useOpenDyslexicFont": {
          "type": "boolean",
          "default": true,
          "description": "Use OpenDyslexic font"
        },
        "dyslexiaFriendly.increaseFontSize": {
          "type": "boolean",
          "default": true,
          "description": "Increase font size"
        },
        "dyslexiaFriendly.increaseLetterSpacing": {
          "type": "boolean",
          "default": true,
          "description": "Increase letter spacing"
        },
        "dyslexiaFriendly.replaceBoldInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Replace italics with bold in editor"
        },
        "dyslexiaFriendly.replaceBoldInCode": {
          "type": "boolean",
          "default": true,
          "description": "Replace italics with bold in code"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus",
          "command": "extension.changeToDyslexiaFriendly",
          "group": "navigation"
        }
      ]
    },
    "themes": [
          {
            "label": "Dyslexia Friendly",
            "uiTheme": "vs-dark",
            "path": "./dyslexia-friendly-current-theme.json"
          }
        ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.9.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}